<%- include('partials/header', { title }) %>
<section class="admin-page"><div class="container"><div class="admin-topline"><div><p class="eyebrow"><span class="eyebrow-line"></span> JOY GALERY / CATALOG</p><h1>Manage the <em>goodies.</em></h1><p class="admin-subtitle">Edit harga, deskripsi, foto, dan visibilitas produk.</p></div><a class="button button-dark" href="/admin/products/new">＋ Tambah produk</a></div><div class="admin-nav"><a href="/admin">Overview</a><a class="active" href="/admin/products">Kelola produk</a><a href="/admin/orders">Pesanan pelanggan</a><a href="/" target="_blank" rel="noopener">Lihat website ↗</a></div><div class="catalog-admin-grid"><% if (products.length) { %><% products.forEach((product) => { %><article class="catalog-admin-card"><div class="catalog-admin-image"><img src="<%= product.image %>" alt=""><span class="admin-active <%= product.active ? 'is-active' : '' %>"><%= product.active ? 'Tayang' : 'Disembunyikan' %></span></div><div class="catalog-admin-content"><p class="product-meta"><span><%= product.category %></span><span>#<%= product.id %></span></p><h2><%= product.name %></h2><p class="admin-product-description"><%= product.description %></p><div class="product-foot"><strong><%= formatPrice(product.price) %></strong><% if (product.featured) { %><span class="featured-label">✳ Featured</span><% } %></div><div class="card-admin-actions"><a class="button button-dark button-small" href="/admin/products/<%= product.id %>/edit">Edit produk ↗</a><form action="/admin/products/<%= product.id %>/delete" method="post" data-confirm="Hapus produk ini dari katalog? Riwayat pesanan akan tetap tersimpan."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small" type="submit">Hapus</button></form></div></div></article><% }) %><% } else { %><div class="empty-state"><span class="empty-star">✳</span><h3>Belum ada produk.</h3><a class="button button-dark" href="/admin/products/new">Tambahkan produk</a></div><% } %></div></div></section>
<%- include('partials/footer') %>
