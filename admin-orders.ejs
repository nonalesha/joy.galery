<%- include('partials/header', { title }) %>
<section class="admin-page"><div class="container"><div class="admin-topline"><div><p class="eyebrow"><span class="eyebrow-line"></span> JOY GALERY / ORDERS</p><h1>Every order, <em>every detail.</em></h1><p class="admin-subtitle">Periksa pembayaran dan kelola pengiriman produk digital.</p></div><a class="button button-outline" href="/admin">← Ringkasan</a></div><div class="admin-nav"><a href="/admin">Overview</a><a href="/admin/products">Kelola produk</a><a class="active" href="/admin/orders">Pesanan pelanggan</a><a href="/" target="_blank" rel="noopener">Lihat website ↗</a></div><form class="order-filters" action="/admin/orders" method="get"><label class="search-field"><span>⌕</span><input type="search" name="q" value="<%= search %>" placeholder="Cari kode, nama, email, WhatsApp..."></label><select name="status" aria-label="Filter status"><option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>Semua status</option><% Object.entries(statuses).forEach(([key, label]) => { %><option value="<%= key %>" <%= selectedStatus === key ? 'selected' : '' %>><%= label %></option><% }) %></select><button class="button button-dark button-small" type="submit">Filter</button><a class="clear-filter" href="/admin/orders">Reset</a></form><div class="table-card"><% if (orders.length) { %><div class="table-scroll"><table class="data-table"><thead><tr><th>Kode pesanan</th><th>Pelanggan</th><th>Produk</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach((order) => { %><tr><td><b><%= order.order_code %></b><small><%= formatDate(order.created_at) %></small></td><td><%= order.customer_name %><small><%= order.email %></small><small><%= order.whatsapp %></small></td><td><%= order.product_name %></td><td><b><%= formatPrice(order.price) %></b></td><td><span class="status-pill <%= statusClass(order.status) %>"><span></span><%= statuses[order.status] %></span></td><td><a class="table-action" href="/admin/orders/<%= order.id %>">Detail ↗</a></td></tr><% }) %></tbody></table></div><p class="table-footnote">Menampilkan maksimum 300 pesanan terakhir yang cocok dengan filter.</p><% } else { %><div class="empty-table"><span>✳</span><h3>Pesanan tidak ditemukan.</h3><p>Coba ubah filter pencarian atau statusnya.</p></div><% } %></div></div></section>
<%- include('partials/footer') %>
