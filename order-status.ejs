<%- include('partials/header', { title }) %>
<section class="page-hero compact-hero"><div class="container"><p class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> YOUR JOY IS ON ITS WAY</p><h1>Order <em>received.</em></h1><p class="compact-lead">Simpan kode pesanan ini untuk melihat status dan detail pengiriman.</p></div></section>
<section class="section order-status-section"><div class="container status-page-grid"><div class="order-confirm-card"><span class="confirmation-icon">✳</span><p class="eyebrow"><span class="eyebrow-line"></span> ORDER NUMBER</p><div class="order-code"><strong><%= order.order_code %></strong><button type="button" class="copy-button" data-copy="<%= order.order_code %>">Salin kode</button></div><div class="status-pill <%= statusClass(order.status) %>"><span></span><%= statuses[order.status] || order.status %></div><div class="status-progress"><div class="progress-node <%= ['waiting_payment','pending_verification','paid','processing','completed'].includes(order.status) ? 'done' : '' %>"><span>1</span><small>Pesanan dibuat</small></div><div class="progress-node <%= ['pending_verification','paid','processing','completed'].includes(order.status) ? 'done' : '' %>"><span>2</span><small>Verifikasi</small></div><div class="progress-node <%= ['processing','completed'].includes(order.status) ? 'done' : '' %>"><span>3</span><small>Pengiriman</small></div></div><p class="status-guidance"><% if (order.status === 'waiting_payment') { %>Pesanan tercatat, tetapi bukti pembayaran belum diterima. Lakukan pembayaran ke QRIS saat checkout dan hubungi admin dengan kode pesanan ini jika perlu. <% } else if (order.status === 'pending_verification') { %>Terima kasih! Bukti pembayaran sudah diterima dan menunggu pemeriksaan admin. <% } else if (order.status === 'paid') { %>Pembayaran telah dikonfirmasi. Pesananmu sedang disiapkan. <% } else if (order.status === 'processing') { %>Pesananmu sedang diproses. Cek kembali halaman ini untuk detail pengiriman. <% } else if (order.status === 'completed') { %>Pesanan selesai. Detail produk digital tersedia di bawah jika sudah ditambahkan oleh admin. <% } else { %>Pesanan ini dibatalkan. Hubungi admin jika kamu memerlukan bantuan lebih lanjut. <% } %></p><div class="status-meta"><span>Dibuat</span><b><%= formatDate(order.created_at) %></b></div><div class="status-meta"><span>Pemesan</span><b><%= order.customer_name %></b></div></div>
<div class="order-detail-card"><p class="eyebrow"><span class="eyebrow-line"></span> ORDER SUMMARY</p><div class="summary-product"><img src="<%= order.product_image %>" alt=""><div><span>Digital product</span><h3><%= order.product_name %></h3></div></div><div class="summary-price"><span>Total</span><strong><%= formatPrice(order.price) %></strong></div><div class="order-divider"></div><h3 class="delivery-heading">Digital delivery</h3><% if (order.status === 'completed' && order.delivery_content) { %><div class="delivery-content"><% if (deliveryIsUrl(order.delivery_content)) { %><a class="button button-dark button-wide" href="<%= order.delivery_content %>" target="_blank" rel="noopener noreferrer">Buka produk digital ↗</a><% } else { %><p><%= order.delivery_content %></p><% } %></div><% } else { %><p class="small-note">Detail unduhan atau akses produk akan ditampilkan di sini setelah admin menyelesaikan pesanan.</p><% } %><a class="text-link" href="/#koleksi">Explore more goodies ↗</a></div></div></section>
<%- include('partials/footer') %>
