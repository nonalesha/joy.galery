# Salin file ini menjadi .env untuk menjalankan lokal.
NODE_ENV=development
PORT=3000
SESSION_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Folder penyimpanan database, sesi login, dan file upload.
# Di Render bisa menggunakan /var/data; di Railway misalnya /data.
DATA_DIR=./data
