<%- include('partials/header', { title }) %>
<section class="admin-page"><div class="container"><div class="admin-topline"><div><p class="eyebrow"><span class="eyebrow-line"></span> JOY GALERY / ADMIN</p><h1>Good day, <em>admin.</em></h1><p class="admin-subtitle">Ini yang sedang terjadi di toko kecilmu.</p></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline" type="submit">Keluar ↗</button></form></div><div class="admin-nav"><a class="active" href="/admin">Overview</a><a href="/admin/products">Kelola produk</a><a href="/admin/orders">Pesanan pelanggan</a><a href="/" target="_blank" rel="noopener">Lihat website ↗</a></div><div class="metric-grid"><article class="metric-card"><span>Total produk</span><strong><%= metrics.products %></strong><small><%= metrics.activeProducts %> aktif di katalog</small><span class="metric-decoration">✳</span></article><article class="metric-card"><span>Total pesanan</span><strong><%= metrics.totalOrders %></strong><small>Semua waktu</small><span class="metric-decoration">↗</span></article><article class="metric-card metric-highlight"><span>Perlu ditindaklanjuti</span><strong><%= metrics.toVerify %></strong><small>Menunggu pembayaran / verifikasi</small><span class="metric-decoration">♡</span></article><article class="metric-card"><span>Pendapatan terkonfirmasi</span><strong class="metric-money"><%= formatPrice(metrics.revenue) %></strong><small>Status paid, processing, selesai</small><span class="metric-decoration">＋</span></article></div><div class="admin-section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> THE LATEST</p><h2>Pesanan terbaru</h2></div><a class="text-link" href="/admin/orders">Semua pesanan ↗</a></div><div class="table-card"><% if (recentOrders.length) { %><div class="table-scroll"><table class="data-table"><thead><tr><th>Kode pesanan</th><th>Pelanggan</th><th>Produk</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% recentOrders.forEach((order) => { %><tr><td><b><%= order.order_code %></b><small><%= formatDate(order.created_at) %></small></td><td><%= order.customer_name %><small><%= order.whatsapp %></small></td><td><%= order.product_name %></td><td><b><%= formatPrice(order.price) %></b></td><td><span class="status-pill <%= statusClass(order.status) %>"><span></span><%= statuses[order.status] %></span></td><td><a class="table-action" href="/admin/orders/<%= order.id %>">Detail ↗</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-table"><span>✳</span><h3>Belum ada pesanan.</h3><p>Pesanan baru akan muncul di sini.</p></div><% } %></div><div class="admin-shortcuts"><a href="/admin/products/new"><span>＋</span><div><b>Tambah produk baru</b><small>Publikasikan produk digital ke katalog.</small></div><span class="shortcut-arrow">↗</span></a><a href="/admin/orders?status=pending_verification"><span>▦</span><div><b>Verifikasi pembayaran</b><small>Periksa bukti pembayaran yang masuk.</small></div><span class="shortcut-arrow">↗</span></a></div></div></section>
<%- include('partials/footer') %>
