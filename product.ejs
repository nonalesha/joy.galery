<%- include('partials/header', { title }) %>
<section class="page-hero compact-hero"><div class="container"><a class="back-link" href="/#koleksi">← Kembali ke koleksi</a><p class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> JOY COLLECTION / <%= product.category.toUpperCase() %></p><h1><%= product.name %><em>.</em></h1><p class="compact-lead">A little digital something, made for your next idea.</p></div></section>
<section class="section product-detail-section"><div class="container product-detail-grid"><div class="detail-image"><% if (product.badge) { %><span class="product-badge"><%= product.badge %></span><% } %><img src="<%= product.image %>" alt="Preview <%= product.name %>"></div><div class="detail-copy"><p class="eyebrow"><span class="eyebrow-line"></span> THE DETAILS</p><h2><%= product.name %></h2><p class="detail-description"><%= product.description %></p><div class="detail-price"><span>Harga produk</span><strong><%= formatPrice(product.price) %></strong></div><a class="button button-dark button-wide" href="/checkout?product_id=<%= product.id %>">Beli sekarang <span>↗</span></a><div class="detail-perks"><div><span>▦</span><p><b>Pembayaran QRIS</b><small>Praktis dan cashless.</small></p></div><div><span>✳</span><p><b>Produk digital</b><small>Detail pengiriman setelah pembayaran dikonfirmasi.</small></p></div><div><span>♡</span><p><b>Curated with care</b><small>Untuk kebutuhan kreatifmu.</small></p></div></div><p class="small-note">Produk contoh di katalog ini dapat diedit atau diganti melalui panel admin sebelum website dipublikasikan.</p></div></div></section>
<% if (related.length) { %><section class="section related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> MORE TO LOVE</p><h2>Maybe you'll like <em>these.</em></h2></div><a class="text-link" href="/#koleksi">All collections ↗</a></div><div class="product-grid"><% related.forEach((item, index) => { %><article class="product-card"><a class="product-image-wrap" href="/produk/<%= item.slug %>"><img class="product-image" src="<%= item.image %>" alt="Preview <%= item.name %>" loading="lazy"><span class="image-arrow">↗</span></a><div class="product-meta"><span><%= item.category %></span><span class="product-index">JG.0<%= index + 1 %></span></div><h3><a href="/produk/<%= item.slug %>"><%= item.name %></a></h3><div class="product-foot"><strong><%= formatPrice(item.price) %></strong><a href="/produk/<%= item.slug %>">Discover <span>↗</span></a></div></article><% }) %></div></div></section><% } %>
<%- include('partials/footer') %>
